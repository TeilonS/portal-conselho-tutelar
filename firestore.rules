rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // FAQ — leitura pública, escrita só para usuários autenticados
    match /faq/{documento} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Notícias — leitura pública, escrita só para usuários autenticados
    match /noticias/{documento} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bloqueia qualquer outra coleção por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
